generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 1. Référentiel géographique et organisationnel
// ============================================================

model Drs {
  id             String          @id @default(uuid())
  nom            String
  code           String          @unique
  actif          Boolean         @default(true)
  moughataas     Moughataa[]
  etablissements Etablissement[]

  @@map("drs")
}

model Moughataa {
  id             String          @id @default(uuid())
  nom            String
  drsId          String          @map("drs_id")
  drs            Drs             @relation(fields: [drsId], references: [id])
  etablissements Etablissement[]

  @@map("moughataa")
}

model Programme {
  id             String          @id @default(uuid())
  nom            String
  code           String          @unique
  actif          Boolean         @default(true)

  produits       Produit[]
  etablissements Etablissement[]
  verrousSaisieInitiale VerrouSaisieInitiale[]

  @@map("programmes")
}

enum TypeEtablissement {
  CAMEC
  GAS_PROGRAMME_NATIONAL
  GAS_DRS
  GAS_MOUGHATAA
  FORMATION_SANITAIRE
}

model Etablissement {
  id                          String            @id @default(uuid())
  nom                         String
  type                        TypeEtablissement
  aStockPhysique              Boolean           @map("a_stock_physique")
  drsId                       String?           @map("drs_id")
  drs                         Drs?              @relation(fields: [drsId], references: [id])
  moughataaId                 String?           @map("moughataa_id")
  moughataa                   Moughataa?        @relation(fields: [moughataaId], references: [id])
  programmeId                 String?           @map("programme_id")
  programme                   Programme?        @relation(fields: [programmeId], references: [id])
  adresse                     String?
  actif                       Boolean           @default(true)
  approvisionnementDirectCamec Boolean          @default(false) @map("approvisionnement_direct_camec")

  userEtablissements          UserEtablissement[]
  lots                        Lot[]
  stocks                      Stock[]
  requisitionsDemandees       Requisition[]     @relation("RequisitionDemandeur")
  requisitionsNiveauActuel    Requisition[]     @relation("RequisitionNiveauActuel")
  blExpedies                  BordereauLivraison[] @relation("BlExpediteur")
  blRecus                     BordereauLivraison[] @relation("BlDestinataire")
  inventaires                 InventairePhysique[]
  notifications                Notification[]
  notificationsEnTantQuAuteur  Notification[] @relation("NotificationAuteur")
  dispensations                Dispensation[]
  pertesTransitExpediees      PerteTransit[]    @relation("PerteTransitExpediteur")
  pertesTransitRecues         PerteTransit[]    @relation("PerteTransitDestinataire")
  justificationsStock          JustificationStock[]
  demandesDestructionLots      DemandeDestructionLot[]
  verrousSaisieInitiale        VerrouSaisieInitiale[]

  @@map("etablissements")
}

// ============================================================
// 2. Utilisateurs et droits
// ============================================================

model Utilisateur {
  id               String              @id @default(uuid())
  nomComplet       String              @map("nom_complet")
  identifiant      String              @unique
  motDePasseHash   String              @map("mot_de_passe_hash")
  telephone        String?
  actif            Boolean             @default(true)
  createdAt        DateTime            @default(now()) @map("created_at")
  estAdminSysteme  Boolean             @default(false) @map("est_admin_systeme")

  etablissements   UserEtablissement[]
  mouvements       MouvementStock[]
  ecartsDecides    BlLigne[]           @relation("EcartDecideur")
  ecartsInventaireDecides LigneInventaire[]
  inventaires      InventairePhysique[]
  dispensations    Dispensation[]
  justificationsStock JustificationStock[]
  destructionsDemandees DemandeDestructionLot[] @relation("DestructionDemandeur")
  destructionsValidees  DemandeDestructionLot[] @relation("DestructionValidateur")
  verrousPoses     VerrouSaisieInitiale[] @relation("VerrouPosePar")

  @@map("utilisateurs")
}

enum Role {
  GESTIONNAIRE_CAMEC
  GESTIONNAIRE_DRS
  DIRECTEUR_DRS
  GAS_MOUGHATAA
  MEDECIN_CHEF_MOUGHATAA
  GAS_PROGRAMME_NATIONAL
  FORMATION_SANITAIRE
  AUDITEUR
}

model UserEtablissement {
  id              String        @id @default(uuid())
  utilisateurId   String        @map("utilisateur_id")
  utilisateur     Utilisateur   @relation(fields: [utilisateurId], references: [id])
  etablissementId String        @map("etablissement_id")
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id])
  role            Role
  dateDebut       DateTime      @default(now()) @map("date_debut")
  actif           Boolean       @default(true)

  @@unique([utilisateurId, etablissementId])
  @@map("user_etablissements")
}

// ============================================================
// 3. Produits et stocks
// ============================================================

model Produit {
  id               String    @id @default(uuid())
  nom              String
  forme            String?
  unite            String?
  seuilMinDefaut   Int       @map("seuil_min_defaut")
  seuilMaxDefaut   Int       @map("seuil_max_defaut")
  programmeId      String    @map("programme_id")
  programme        Programme @relation(fields: [programmeId], references: [id])

  lots             Lot[]
  stocks           Stock[]
  requisitionLignes RequisitionLigne[]
  blLignes         BlLigne[]
  notifications    Notification[]
  dispensations    Dispensation[]
  pertesTransit    PerteTransit[]
  justificationsStock JustificationStock[]

  @@map("produits")
}

// Un numéro de lot est unique à l'échelle d'un établissement : il ne peut
// désigner qu'un seul produit, et sa péremption est invariante une fois
// fixée (toute tentative contraire doit être rejetée côté application).
model Lot {
  id              String        @id @default(uuid())
  produitId       String        @map("produit_id")
  produit         Produit       @relation(fields: [produitId], references: [id])
  etablissementId String        @map("etablissement_id")
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id])
  numeroLot       String        @map("numero_lot")
  datePeremption  DateTime      @map("date_peremption")
  quantite        Int
  dateReception   DateTime      @default(now()) @map("date_reception")
  fournisseur     String?
  prixUnitaire    Decimal?      @map("prix_unitaire") @db.Decimal(12, 2)
  note            String?

  mouvements      MouvementStock[]
  blLignes        BlLigne[]
  lignesInventaire LigneInventaire[]
  demandesDestruction DemandeDestructionLot[]

  @@unique([etablissementId, numeroLot])
  @@map("lots")
}

enum StatutStock {
  RUPTURE
  SOUS_SEUIL
  NORMAL
  SURSTOCK
}

model Stock {
  id                String        @id @default(uuid())
  produitId         String        @map("produit_id")
  produit           Produit       @relation(fields: [produitId], references: [id])
  etablissementId   String        @map("etablissement_id")
  etablissement     Etablissement @relation(fields: [etablissementId], references: [id])
  quantiteTotale    Int           @default(0) @map("quantite_totale")
  seuilMin          Int           @map("seuil_min")
  seuilMax          Int           @map("seuil_max")
  statut            StatutStock   @default(RUPTURE)
  derniereMajStatut DateTime?     @map("derniere_maj_statut")

  @@unique([produitId, etablissementId])
  @@map("stocks")
}

enum TypeMouvement {
  ENTREE
  SORTIE
  AJUSTEMENT
  BLOCAGE_ECART
  DEBLOCAGE_ECART
}

enum ReferenceType {
  REQUISITION
  BL
  MANUEL
  DISPENSATION
  DESTRUCTION
}
model MouvementStock {
  id             String         @id @default(uuid())
  lotId          String         @map("lot_id")
  lot            Lot            @relation(fields: [lotId], references: [id])
  type           TypeMouvement
  quantite       Int
  dateMouvement  DateTime       @default(now()) @map("date_mouvement")
  referenceType  ReferenceType? @map("reference_type")
  referenceId    String?        @map("reference_id")
  utilisateurId  String         @map("utilisateur_id")
  utilisateur    Utilisateur    @relation(fields: [utilisateurId], references: [id])

  @@map("mouvements_stock")
}

// ============================================================
// 4. Circuit de validation (réquisitions et distribution)
// ============================================================

enum StatutRequisition {
  BROUILLON
  EN_ATTENTE
  MODIFIEE_EN_ATTENTE_CONFIRMATION
  REJETEE_POUR_CORRECTION
  VALIDEE
  REJETEE
  EXPEDIEE
  CLOTUREE
  SCINDEE
}

model Requisition {
  id                     String            @id @default(uuid())
  numero                 Int               @unique @default(autoincrement())
  etablissementDemandeurId String          @map("etablissement_demandeur_id")
  etablissementDemandeur  Etablissement    @relation("RequisitionDemandeur", fields: [etablissementDemandeurId], references: [id])
  niveauActuelId         String            @map("niveau_actuel_id")
  niveauActuel           Etablissement     @relation("RequisitionNiveauActuel", fields: [niveauActuelId], references: [id])
  statut                 StatutRequisition @default(BROUILLON)
  dateCreation           DateTime          @default(now()) @map("date_creation")
  dateDerniereMaj        DateTime          @updatedAt @map("date_derniere_maj")
  justification          String?

  requisitionParentId    String?           @map("requisition_parent_id")
  requisitionParent      Requisition?      @relation("RequisitionEnfants", fields: [requisitionParentId], references: [id])
  requisitionsEnfants    Requisition[]     @relation("RequisitionEnfants")

  lignes                 RequisitionLigne[]
  bordereaux             BordereauLivraison[]
  notifications          Notification[]

  @@map("requisitions")
}

model RequisitionLigne {
  id                String      @id @default(uuid())
  requisitionId     String      @map("requisition_id")
  requisition       Requisition @relation(fields: [requisitionId], references: [id])
  produitId         String      @map("produit_id")
  produit           Produit     @relation(fields: [produitId], references: [id])
  quantiteDemandee  Int         @map("quantite_demandee")
  quantiteValidee   Int         @map("quantite_validee")

  @@map("requisition_lignes")
}

enum StatutBl {
  ENVOYE
  RECU_SANS_ECART
  RECU_AVEC_ECART_BLOQUE
  RECU_AVEC_ECART_DEBLOQUE
}

model BordereauLivraison {
  id                          String        @id @default(uuid())
  numero                      Int           @unique @default(autoincrement())
  requisitionId               String        @map("requisition_id")
  requisition                 Requisition   @relation(fields: [requisitionId], references: [id])
  etablissementExpediteurId   String        @map("etablissement_expediteur_id")
  etablissementExpediteur     Etablissement @relation("BlExpediteur", fields: [etablissementExpediteurId], references: [id])
  etablissementDestinataireId String        @map("etablissement_destinataire_id")
  etablissementDestinataire   Etablissement @relation("BlDestinataire", fields: [etablissementDestinataireId], references: [id])
  dateEnvoi                   DateTime      @default(now()) @map("date_envoi")
  dateReceptionConfirmee      DateTime?     @map("date_reception_confirmee")
  statut                      StatutBl      @default(ENVOYE)

  lignes                      BlLigne[]

  @@map("bordereaux_livraison")
}

enum EcartStatut {
  EN_ATTENTE
  DEBLOQUE
  MAINTENU
}

model BlLigne {
  id                    String              @id @default(uuid())
  blId                  String              @map("bl_id")
  bl                    BordereauLivraison  @relation(fields: [blId], references: [id])
  produitId             String              @map("produit_id")
  produit               Produit             @relation(fields: [produitId], references: [id])
  lotId                 String              @map("lot_id")
  lot                   Lot                 @relation(fields: [lotId], references: [id])
  quantiteEnvoyee       Int                 @map("quantite_envoyee")
  quantiteRecue         Int?                @map("quantite_recue")
  ecart                 Int?
  ecartStatut           EcartStatut?        @map("ecart_statut")
  ecartDecideurId       String?             @map("ecart_decideur_id")
  ecartDecideur         Utilisateur?        @relation("EcartDecideur", fields: [ecartDecideurId], references: [id])
  ecartMotif            String?             @map("ecart_motif")
  compensationRequise   Boolean             @default(false) @map("compensation_requise")

  perteTransit          PerteTransit?

  @@map("bl_lignes")
}

// Enregistrée uniquement quand un écart de BL est tranché "Maintenu" sur un
// vrai manque (ecart > 0 : moins reçu qu'envoyé) — jamais sur un surplus.
// Sert à repérer, par établissement et par produit, les pertes en transit
// récurrentes qu'on choisit de ne pas faire remonter en compensation.
model PerteTransit {
  id                          String        @id @default(uuid())
  blLigneId                   String        @unique @map("bl_ligne_id")
  blLigne                     BlLigne       @relation(fields: [blLigneId], references: [id])
  produitId                   String        @map("produit_id")
  produit                     Produit       @relation(fields: [produitId], references: [id])
  etablissementExpediteurId   String        @map("etablissement_expediteur_id")
  etablissementExpediteur     Etablissement @relation("PerteTransitExpediteur", fields: [etablissementExpediteurId], references: [id])
  etablissementDestinataireId String        @map("etablissement_destinataire_id")
  etablissementDestinataire   Etablissement @relation("PerteTransitDestinataire", fields: [etablissementDestinataireId], references: [id])
  quantitePerdue              Int           @map("quantite_perdue")
  dateConstat                 DateTime      @default(now()) @map("date_constat")

  @@map("pertes_transit")
}

// ============================================================
// 5. Inventaire physique (comptage terrain vs stock calculé)
// ============================================================

enum TypeInventaire {
  PONCTUEL
  PERIODIQUE
}

model InventairePhysique {
  id              String            @id @default(uuid())
  etablissementId String            @map("etablissement_id")
  etablissement   Etablissement     @relation(fields: [etablissementId], references: [id])
  effectueParId   String            @map("effectue_par_id")
  effectuePar     Utilisateur       @relation(fields: [effectueParId], references: [id])
  dateInventaire  DateTime          @default(now()) @map("date_inventaire")
  type            TypeInventaire
  commentaire     String?

  lignes          LigneInventaire[]

  @@map("inventaires_physiques")
}

model LigneInventaire {
  id               String             @id @default(uuid())
  inventaireId     String             @map("inventaire_id")
  inventaire       InventairePhysique @relation(fields: [inventaireId], references: [id])
  lotId            String             @map("lot_id")
  lot              Lot                @relation(fields: [lotId], references: [id])
  quantiteSysteme  Int                @map("quantite_systeme")
  quantitePhysique Int                @map("quantite_physique")
  ecart            Int
  ecartStatut      EcartStatut?       @map("ecart_statut")
  ecartDecideurId  String?            @map("ecart_decideur_id")
  ecartDecideur    Utilisateur?       @relation(fields: [ecartDecideurId], references: [id])
  ecartMotif       String?            @map("ecart_motif")

  @@map("lignes_inventaire")
}

// ============================================================
// 6. Notifications (informer les établissements des décisions prises
//    sur leurs réquisitions, sans bloquer le circuit)
// ============================================================

enum TypeNotification {
  VALIDEE
  MODIFIEE
  SCINDEE
  REJETEE_POUR_CORRECTION
  RUPTURE_STOCK
  ECART_A_COMPENSER
}

model Notification {
  id              String            @id @default(uuid())
  etablissementId String            @map("etablissement_id")
  etablissement   Etablissement     @relation(fields: [etablissementId], references: [id])
  etablissementAuteurId String?     @map("etablissement_auteur_id")
  etablissementAuteur   Etablissement? @relation("NotificationAuteur", fields: [etablissementAuteurId], references: [id])
  type            TypeNotification
  message         String
  requisitionId   String?           @map("requisition_id")
  requisition     Requisition?      @relation(fields: [requisitionId], references: [id])
  produitId       String?           @map("produit_id")
  produit         Produit?          @relation(fields: [produitId], references: [id])
  lue             Boolean           @default(false)
  createdAt       DateTime          @default(now()) @map("created_at")

  @@map("notifications")
}

// ============================================================
// 7. Dispensations (sortie vers un bénéficiaire final — patient,
//    laboratoire, maternité ou autre service interne)
// ============================================================

enum TypeBeneficiaire {
  PATIENT
  LABORATOIRE
  MATERNITE
  SERVICE
  AUTRE
}

enum StatutDispensation {
  ACTIVE
  ANNULEE
}

model Dispensation {
  id                String              @id @default(uuid())
  numero            Int                 @unique @default(autoincrement())
  etablissementId   String              @map("etablissement_id")
  etablissement     Etablissement       @relation(fields: [etablissementId], references: [id])
  produitId         String              @map("produit_id")
  produit           Produit             @relation(fields: [produitId], references: [id])
  quantite          Int
  typeBeneficiaire  TypeBeneficiaire    @map("type_beneficiaire")
  beneficiaire      String?
  utilisateurId     String              @map("utilisateur_id")
  utilisateur       Utilisateur         @relation(fields: [utilisateurId], references: [id])
  dateDispensation  DateTime            @default(now()) @map("date_dispensation")
  statut            StatutDispensation  @default(ACTIVE)
  motifAnnulation   String?             @map("motif_annulation")

  @@map("dispensations")
}

// ============================================================
// 8. Justifications de stock (rupture / surstock) — historique daté
//    complet. Obligatoire uniquement pour les statuts RUPTURE et SURSTOCK
//    (voir STATUTS_JUSTIFICATION_OBLIGATOIRE côté backend). Seul le
//    gestionnaire de l'établissement concerné peut justifier son propre
//    stock : imposé côté application via la session (etablissementId du
//    token), jamais via une valeur envoyée par le client.
// ============================================================
model JustificationStock {
  id              String        @id @default(uuid())
  produitId       String        @map("produit_id")
  produit         Produit       @relation(fields: [produitId], references: [id])
  etablissementId String        @map("etablissement_id")
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id])
  statut          StatutStock
  texte           String
  utilisateurId   String        @map("utilisateur_id")
  utilisateur     Utilisateur   @relation(fields: [utilisateurId], references: [id])
  dateCreation    DateTime      @default(now()) @map("date_creation")

  @@index([produitId, etablissementId])
  @@map("justifications_stock")
}

// ============================================================
// 9. Destruction des lots périmés — un lot périmé (datePeremption <
//    aujourd'hui) est automatiquement exclu du stock disponible côté
//    application (filtre au calcul, pas de champ dédié ici). Cette table
//    ne sert qu'à l'étape administrative a posteriori : le gestionnaire
//    de l'établissement qui détient le lot demande sa destruction
//    physique, et seul un compte GAS_PROGRAMME_NATIONAL ou ADMIN (rôle
//    virtuel, non présent dans l'enum Role — voir estAdminSysteme) peut
//    valider, sans comité ni hiérarchie par établissement. La validation
//    décrémente définitivement Lot.quantite et trace un MouvementStock
//    de type DESTRUCTION. L'historique des demandes validées peut être
//    intégralement supprimé, mais uniquement par un ADMIN.
// ============================================================
enum StatutDemandeDestruction {
  EN_ATTENTE
  VALIDEE
  REJETEE
}

model DemandeDestructionLot {
  id                    String                   @id @default(uuid())
  lotId                 String                   @map("lot_id")
  lot                   Lot                      @relation(fields: [lotId], references: [id])
  etablissementId       String                   @map("etablissement_id")
  etablissement         Etablissement            @relation(fields: [etablissementId], references: [id])
  quantiteDemandee      Int                      @map("quantite_demandee")
  motifDemande          String?                  @map("motif_demande")
  demandeurId           String                   @map("demandeur_id")
  demandeur             Utilisateur              @relation("DestructionDemandeur", fields: [demandeurId], references: [id])
  dateDemande           DateTime                 @default(now()) @map("date_demande")
  statut                StatutDemandeDestruction @default(EN_ATTENTE)
  quantiteDetruite      Int?                     @map("quantite_detruite")
  validateurId          String?                  @map("validateur_id")
  validateur            Utilisateur?             @relation("DestructionValidateur", fields: [validateurId], references: [id])
  dateValidation        DateTime?                @map("date_validation")
  commentaireValidation String?                  @map("commentaire_validation")

  @@index([lotId])
  @@index([etablissementId])
  @@map("demandes_destruction_lots")
}

// ============================================================
// 10. Verrou de saisie initiale — une fois la dotation de départ saisie
//    via /stocks/entree, l'autorité de la zone peut verrouiller cette
//    voie pour empêcher tout ajout manuel non audité par la suite (en
//    dehors du circuit officiel réquisition/BL). programmeId nullable :
//    null = verrou total (tous produits), renseigné = verrou limité aux
//    produits de ce programme (cas GAS_PROGRAMME_NATIONAL, qui ne peut
//    verrouiller un GAS_DRS que pour son propre programme, les autres
//    programmes restant libres à ce même GAS_DRS). CAMEC n'est jamais une
//    cible : c'est le point d'entrée officiel du circuit, toujours libre.
//    Pas de @@unique : la sémantique NULL de Postgres rendrait une
//    contrainte (etablissementId, programmeId) inopérante pour détecter
//    les doublons de verrou total — la déduplication est donc faite côté
//    application (voir verrouillerMaZone). Seul un ADMIN peut lever un
//    verrou, quel que soit le rôle qui l'a posé à l'origine.
// ============================================================
model VerrouSaisieInitiale {
  id               String        @id @default(uuid())
  etablissementId  String        @map("etablissement_id")
  etablissement    Etablissement @relation(fields: [etablissementId], references: [id])
  programmeId      String?       @map("programme_id")
  programme        Programme?    @relation(fields: [programmeId], references: [id])
  poseParId        String        @map("pose_par_id")
  posePar          Utilisateur   @relation("VerrouPosePar", fields: [poseParId], references: [id])
  dateVerrouillage DateTime      @default(now()) @map("date_verrouillage")

  @@index([etablissementId])
  @@map("verrous_saisie_initiale")
}